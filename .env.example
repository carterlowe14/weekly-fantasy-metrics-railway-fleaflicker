# Example Railway env file for the compact weekly report app
# Replace placeholders before running the app.
# Role ping requires the Discord role ID, not the role name.

PLATFORM=fleaflicker
LEAGUE_ID=123456
DISCORD_WEBHOOK_ID=123456789012345678/abcdefghijklmnopqrstuvwxyz
DISCORD_ROLE_ID=123456789012345678
DISCORD_CHANNEL_NOTIFY_BOOL=true
DISCORD_POST_BOOL=true
DISCORD_POST_OR_FILE=file
CHECK_FOR_UPDATES=false
USE_DEFAULT=1
